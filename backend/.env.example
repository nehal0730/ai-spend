PORT=5000
# NOTE: This file contained secrets that should not be checked into source control.
# Replace these placeholder values with real secrets in your local environment.
# Add these in .env file and update with real values. See .env.example for guidance.

DATABASE_URL=postgresql://postgres:REPLACE_ME_PASSWORD@db.example.supabase.co:5432/postgres
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME_SUPABASE_SERVICE_ROLE_KEY

NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_MAX=100
LOG_LEVEL=info

PUBLIC_BASE_URL=http://localhost:5000
FRONTEND_BASE_URL=http://localhost:5173

# Gemini / Google Generative AI (optional). Leave blank to use summary fallback.
GEMINI_API_KEY=
GEMINI_API_URL=